# Application Configuration
PROJECT_NAME="Legal Metrology Compliance Scanner"
API_V1_STR="/api/v1"
SECRET_KEY="legal-metrology-secret-key-for-jwt-signing-change-in-production-siih2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration
# In production with PostgreSQL: postgresql://postgres:postgres@localhost:5432/legal_metrology_db
# For lightweight standalone/test setup: sqlite:///./legal_metrology.db
DATABASE_URL="sqlite:///./legal_metrology.db"

# Storage & Uploads
UPLOAD_DIR="./uploads"
REPORT_OUTPUT_DIR="./generated_reports"

# Default Admin & Inspector initial seeds
FIRST_SUPERUSER_EMAIL="admin@legalmetrology.gov.in"
FIRST_INSPECTOR_EMAIL="inspector.mumbai@legalmetrology.gov.in"
FIRST_INSPECTOR_PASSWORD="InspectorPassword@123"

# --- Public APIs & AI Integration (public-apis/public-apis) ---
# Provide your Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=""
OPENAI_API_KEY=""
HUGGINGFACE_API_KEY=""

# Public API Endpoints (Free, no key required)
OPEN_FOOD_FACTS_API_URL="https://world.openfoodfacts.org"
POSTAL_PINCODE_API_URL="https://api.postalpincode.in"
EXCHANGE_RATE_API_URL="https://open.er-api.com/v6/latest"
OPEN_METEO_API_URL="https://api.open-meteo.com/v1"
